# AegisNet — environment template.
# Copy with `make bootstrap`, which replaces every __REPLACE_ME__ with a random
# development-only secret and writes .env with 0600 permissions.
# .env is gitignored. NEVER commit real secrets.
# The application refuses to start if any secret still holds a placeholder and ENV != test.

# ---- Application ----
ENV=development                 # development | test | production
DEBUG=false
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_NAME=aegisnet
GIT_SHA=unknown                 # injected at build time in CI

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:3000
SECRET_KEY=__REPLACE_ME__       # signing key; unused until Chunk 6 auth, required now so it is never a placeholder later

# ---- PostgreSQL ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=aegisnet
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__REPLACE_ME__
POSTGRES_APP_USER=aegisnet_app
POSTGRES_APP_PASSWORD=__REPLACE_ME__
POSTGRES_MIGRATOR_USER=aegisnet_migrator
POSTGRES_MIGRATOR_PASSWORD=__REPLACE_ME__

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__

# ---- Frontend ----
NEXT_PUBLIC_APP_NAME=AegisNet
