# AegisNet — environment template.
# Copy with `make bootstrap`, which replaces every __REPLACE_ME__ with a random
# development-only secret and writes .env with 0600 permissions.
# .env is gitignored. NEVER commit real secrets.
# The application refuses to start if any secret still holds a placeholder and ENV != test.
#
# Comments must live on their own line. Docker Compose `env_file` does NOT strip a trailing
# `# comment`, so `KEY=value  # note` would deliver the comment text as part of the value.

# ---- Application ----
# ENV: development | test | production
ENV=development
DEBUG=false
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
APP_NAME=aegisnet
# GIT_SHA is injected at build time in CI.
GIT_SHA=unknown

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:3000
# Signs the access tokens (HS256). Changing it invalidates every access token already issued;
# refresh and service tokens are random values stored as digests, so they are unaffected by it.
SECRET_KEY=__REPLACE_ME__

# ---- PostgreSQL ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=aegisnet
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__REPLACE_ME__
POSTGRES_APP_USER=aegisnet_app
POSTGRES_APP_PASSWORD=__REPLACE_ME__
POSTGRES_MIGRATOR_USER=aegisnet_migrator
POSTGRES_MIGRATOR_PASSWORD=__REPLACE_ME__
# The retention job's own role. It may DELETE only from the four tables with a retention period,
# and it is the only role that may delete from them; the app role has one DELETE grant of its
# own, on asset_networks, because PATCH /assets/{id} replaces those rows wholesale (ADR-015).
POSTGRES_RETENTION_USER=aegisnet_retention
POSTGRES_RETENTION_PASSWORD=__REPLACE_ME__
DB_STATEMENT_TIMEOUT_MS=5000
DB_JOB_STATEMENT_TIMEOUT_MS=300000

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__

# ---- Health probes ----
# How long /readyz waits on PostgreSQL and Redis before reporting a dependency down. It is also
# the Redis socket timeout for the client and the broker, so a probe cannot hang on a dead peer.
PROBE_TIMEOUT_SECONDS=3.0

# ---- Datasets and ingest ----
# Directory holding registry.yml. The api and worker containers mount ./samples read-only at
# /app/samples and set this themselves, which is how every documented command reaches it — the
# CLI targets all run through Compose. This value never reaches a native run started by the
# Makefile: settings read .env from the working directory and those targets run from backend/,
# which has no .env. A native run either passes --samples-dir or keeps its own .env in backend/,
# where ../samples is the right answer.
SAMPLES_DIR=../samples
INGEST_MAX_BODY_BYTES=52428800
INGEST_MAX_LINES=200000
INGEST_MAX_LINE_BYTES=65536
INGEST_MAX_JSON_DEPTH=12
INGEST_MAX_KEYS_PER_OBJECT=200
INGEST_TIMESTAMP_MAX_PAST_DAYS=3650
INGEST_TIMESTAMP_MAX_FUTURE_HOURS=24
INGEST_SYNC_MAX_LINES=1000
INGEST_UPLOAD_TIMEOUT_SECONDS=120
# Where async uploads wait for the worker. The api and worker containers share a volume
# at /app/spool and set this themselves.
SPOOL_DIR=spool

# ---- Authentication and rate limits ----
# SECRET_KEY above signs the access tokens (HS256).
JWT_ISSUER=aegisnet
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=60
LOGIN_FAILURE_RESET_HOURS=24
# The refresh cookie is Secure by default. Set false only for a plain-http local lab.
COOKIE_SECURE=true
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_LOGIN_IP_PER_15MIN=5
RATE_LIMIT_INGEST_PER_MIN=30
RATE_LIMIT_INGEST_BYTES_PER_HOUR=209715200
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_DEFAULT_PER_MIN=60

# ---- Schedule (ADR-020) ----
# The scheduler service sends a sweep every SWEEP_CADENCE_MINUTES (must divide 60) over the
# last SWEEP_LOOKBACK_MINUTES; overlap between ticks is absorbed by the alert dedup key.
SWEEP_CADENCE_MINUTES=10
SWEEP_LOOKBACK_MINUTES=60
# Nightly baseline recompute: hour on the scheduler's clock (UTC in the image), window in days.
BASELINE_RECOMPUTE_HOUR=2
BASELINE_WINDOW_DAYS=7
# A scheduled message older than this when a worker picks it up is skipped, not replayed.
SCHEDULE_SKIP_DELAY_SECONDS=300
# Queue a sweep over a batch's event-time span as soon as the batch completes.
POST_INGEST_SWEEP=true

# ---- Retention (ADR-033) ----
# Off by default, because deletion is the one thing here that cannot be undone: a lab that has
# been running a while should not lose its history because somebody started the stack. The
# nightly message is sent either way and the actor reads this flag, so turning the policy on is
# this line and a worker restart. Only aegisnet_retention may DELETE, and only these four tables.
RETENTION_ENABLED=false
# Hour on the scheduler's clock (UTC in the image).
RETENTION_HOUR=3
RETENTION_EVENTS_DAYS=90
RETENTION_REJECTS_DAYS=30
RETENTION_DETECTOR_RUNS_DAYS=30
# Never below 30: an audit trail shorter than a month cannot answer the question it exists for,
# and a retention setting is exactly where somebody would shorten it.
RETENTION_AUDIT_DAYS=365
# Rows per DELETE, and how many of those one nightly run may do before it stops. A first prune of
# a long-neglected table finishes and leaves the rest for tomorrow rather than holding locks.
RETENTION_BATCH_ROWS=5000
RETENTION_MAX_BATCHES=200

# ---- Frontend ----
NEXT_PUBLIC_APP_NAME=AegisNet
# Where the dashboard reaches the API, from inside the Compose network. Server-side
# only: the browser never learns this address and never holds a token (ADR-026).
AEGISNET_API_URL=http://api:8000

# ---- the investigation brief (docs/perplexity-integration.md; ADR-029, ADR-030)
# The only feature that sends anything outside this deployment. Off unless you turn it on,
# and a key alone does nothing without the flag.
BRIEF_ENABLED=false
# A hard stop on spend and on exposure for the whole deployment: past this many calls in a UTC
# day the answer is no. The two below bound one analyst and one case inside that budget, because
# one number for everybody is not a limit on anybody in particular.
BRIEF_DAILY_BUDGET=50
BRIEF_USER_DAILY_LIMIT=20
BRIEF_INCIDENT_DAILY_LIMIT=10
# The one address the settings accept: there is no setting that points this somewhere else and
# none that turns certificate verification off (T-3.6).
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar
PERPLEXITY_TIMEOUT_SECONDS=30.0
PERPLEXITY_MAX_RETRIES=2
# A cap on the model's reply, not a credential — but the test that keeps real secrets out of this
# file matches any name containing TOKEN, and that heuristic is worth more than this line is. It
# stays commented rather than weakening the check; the default is 1200.
# PERPLEXITY_MAX_TOKENS=1200
# A response larger than this is not read (T-4.5).
PERPLEXITY_MAX_RESPONSE_BYTES=262144
# The key stays commented out on purpose. `make bootstrap` replaces every placeholder with a
# random secret, and a random string here would look exactly like a configured key to anyone
# reading .env. Uncomment and paste a real one when you turn the feature on.
# PERPLEXITY_API_KEY=pplx-...
