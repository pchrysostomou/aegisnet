# AegisNet — ignore rules.
#
# Two categories matter more than convenience here:
#   1. Secrets. Nothing that can authenticate anything may ever be committed.
#   2. Captured or real telemetry. Packet captures and live sensor output can contain real
#      addresses, hostnames, credentials, and payload bytes. They are treated as sensitive
#      data, not as test fixtures. Only synthetic, reviewed corpora are ever committed.

# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
!**/testdata/**/*.crt
secrets/
.secrets/

# Local Compose overrides. Compose loads this automatically once it exists, so it can
# silently change bind addresses, mounts, or hardening on one machine only. Keep it local.
docker-compose.override.yml
!docker-compose.override.yml.example
.netrc
.npmrc
credentials.json
service-account*.json

# ---------------------------------------------------------------- captured / live telemetry
# Never commit raw captures or real sensor output — see SECURITY.md. The isolated lab writes
# into infra/lab/out/, which these rules already cover; the only capture that may be
# committed is a sanitised excerpt under samples/lab/, which tools/sanitize_eve.py produces
# and refuses to produce when anything outside documentation space survives (ADR-021).
*.pcap
*.pcapng
*.cap
eve.json
eve*.json
!samples/synthetic/**/*.json
suricata/logs/
zeek/logs/
logs/
*.log

# Operator-fetched public datasets are licence-restricted and stay local.
samples/external/

# ---------------------------------------------------------------- database volumes / dumps
pgdata/
infra/postgres/data/
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
junit*.xml
dist/
build/
*.egg-info/
.tox/

# ---------------------------------------------------------------- Node / Next.js
node_modules/
.next/
# Next.js and the lab's capture directory. infra/lab/out/.gitignore is tracked with
# `git add -f` so a clone has the directory, and so the intent is visible where a capture
# actually lands.
out/
.pnpm-store/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
pnpm-debug.log*

# ---------------------------------------------------------------- tooling / editors
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- local scratch
docs/screenshots/*.tmp
tmp/
scratch/

# Local sonar-scanner run against a developer's own SonarQube
.scannerwork/
