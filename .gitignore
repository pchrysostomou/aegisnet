# AegisNet — ignore rules.
#
# Two categories matter more than convenience here:
#   1. Secrets. Nothing that can authenticate anything may ever be committed.
#   2. Captured or real telemetry. Packet captures and live sensor output can contain real
#      addresses, hostnames, credentials, and payload bytes. They are treated as sensitive
#      data, not as test fixtures. Only synthetic, reviewed corpora are ever committed.

# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
!**/testdata/**/*.crt
secrets/
.secrets/
.netrc
.npmrc
credentials.json
service-account*.json

# ---------------------------------------------------------------- captured / live telemetry
# Never commit raw captures or real sensor output — see SECURITY.md.
*.pcap
*.pcapng
*.cap
eve.json
eve*.json
!samples/synthetic/**/*.json
suricata/logs/
zeek/logs/
logs/
*.log

# Operator-fetched public datasets are licence-restricted and stay local.
samples/external/

# ---------------------------------------------------------------- database volumes / dumps
pgdata/
infra/postgres/data/
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
junit*.xml
dist/
build/
*.egg-info/
.tox/

# ---------------------------------------------------------------- Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
pnpm-debug.log*

# ---------------------------------------------------------------- tooling / editors
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- local scratch
docs/screenshots/*.tmp
tmp/
scratch/
